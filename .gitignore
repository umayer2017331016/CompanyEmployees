## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Visual Studio auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# BenchmarkDotNet artifacts
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Runtime generated
*.dbmdl
*.jfm

# Entity Framework
*.ide
*.mdf
*.ldf

# DotNet CLI
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Rider
.idea/

# JetBrains Rider
*.sln.iml

# Others
*.log
*.tlog
*.cache
*.tmp

# JSON configuration transformations
appsettings.*.json

# Sensitive files (optional)
secret.json

# macOS files
.DS_Store

# Logs
logs/
*.log

# Node (if using React/Angular)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Publish output
publish/
dist/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio Code
.vscode/

# Environment Specific
.env

